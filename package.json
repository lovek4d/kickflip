{
  "name": "@lovek4d/kickflip",
  "version": "0.19.0",
  "description": "Follow and steer Claude Code sessions from your phone.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovek4d/kickflip.git"
  },
  "private": true,
  "type": "module",
  "bin": {
    "kickflip": "bin/kickflip.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "board/",
    "hub/",
    "shared/",
    "starter/",
    "hooks-plugin/",
    "docs/hub-session.md",
    "SKILL.md",
    "CONTEXT.md",
    "!**/*.test.mjs",
    "!**/*.bench.mjs",
    "!board/mini-dom.mjs",
    "!board/board-fixture.mjs",
    "!hub/fake-device.mjs",
    "!shared/test-helpers.mjs",
    "!shared/scratch-home.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "bench": "node --test --test-timeout=300000 \"board/**/*.bench.mjs\""
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
