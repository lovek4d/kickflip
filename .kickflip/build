#!/usr/bin/env node
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import net from 'node:net';
import http from 'node:http';
import { spawn } from 'node:child_process';
import { createInterface } from 'node:readline';
import { makePin, redeemPin, SIGN_IN_COOKIE } from '../shared/owner-sign-in.mjs';

const worktree = path.resolve(process.argv[3] || process.cwd());
const home = fs.mkdtempSync(path.join(os.tmpdir(), 'kickflip-try-'));
let hub;
let front;
let stopping = false;

process.on('exit', () => fs.rmSync(home, { recursive: true, force: true }));
function stop() {
  if (stopping) return;
  stopping = true;
  front?.closeAllConnections();
  front?.close();
  if (hub) hub.kill('SIGTERM');
  else process.exit(0);
}
process.on('SIGTERM', stop);
process.on('SIGINT', stop);

async function freePort(exclude) {
  for (;;) {
    const server = net.createServer();
    await new Promise((resolve, reject) => {
      server.once('error', reject);
      server.listen(0, '127.0.0.1', resolve);
    });
    const port = server.address().port;
    await new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
    // The owner's hub and site range must never be used by a try run.
    if (port !== exclude && port !== 4500 && (port < 4600 || port > 4699)) return port;
  }
}

function writeJSON(file, value) {
  fs.writeFileSync(file, JSON.stringify(value, null, 2) + '\n');
}

// The demo's own sign-in, made in its throwaway HOME: a device cookie its hub accepts. The try relay never passes the
// owner's cookie to a card's app, so this front port, which the relay serves, gives every request the demo's own.
async function demoCookie() {
  const { device } = await redeemPin((await makePin({ home })).pin, { key: 'demo', name: 'Demo' }, { home });
  return `${SIGN_IN_COOKIE}=${device}`;
}

// Listens on port and passes each request and upgrade to the demo hub on hubPort, the demo's cookie its only one.
function startFront(port, hubPort, cookie) {
  const withCookie = (headers) => ({ ...headers, cookie });
  front = http.createServer((req, res) => {
    const up = http.request({ host: '127.0.0.1', port: hubPort, method: req.method, path: req.url, headers: withCookie(req.headers) }, (answer) => {
      res.writeHead(answer.statusCode, answer.headers);
      answer.pipe(res);
    });
    up.on('error', () => { if (res.headersSent) res.destroy(); else res.writeHead(502).end(); });
    req.pipe(up);
  });
  front.on('upgrade', (req, socket, head) => {
    const up = net.connect(hubPort, '127.0.0.1', () => {
      const headers = Object.entries(withCookie(req.headers)).map(([name, value]) => `${name}: ${value}\r\n`).join('');
      up.write(`${req.method} ${req.url} HTTP/1.1\r\n${headers}\r\n`);
      up.write(head);
      socket.pipe(up);
      up.pipe(socket);
    });
    up.on('error', () => socket.destroy());
    socket.on('error', () => up.destroy());
  });
  return new Promise((resolve, reject) => { front.once('error', reject); front.listen(port, '127.0.0.1', resolve); });
}

async function main() {
  const port = await freePort();
  const hubPort = await freePort(port);
  const sitePort = await freePort(hubPort);
  await startFront(port, hubPort, await demoCookie());
  const root = path.join(home, '.claude', 'kickflip');
  const dir = path.join(root, 'sites', 'demo');
  fs.mkdirSync(path.join(dir, 'data'), { recursive: true });
  writeJSON(path.join(root, 'manifest.json'), {
    version: 1,
    sites: {
      demo: {
        dir, port: sitePort, title: 'Demo',
        cmd: [process.execPath, path.join(worktree, 'board', 'server.mjs'), dir],
        watch: ['data/events.jsonl'],
      },
    },
  });
  writeJSON(path.join(dir, 'board.json'), { title: 'Demo', items: 'data/items.json', slug: 'demo' });
  writeJSON(path.join(dir, 'data', 'items.json'), {
    title: 'Demo',
    items: [
      { id: 'D-1', title: 'Add a search box to the board' },
      { id: 'D-2', title: 'Show when a card last changed', status: 'building' },
      { id: 'D-3', title: 'Check the board on a small screen', status: 'checking' },
      { id: 'D-4', title: 'Save the selected board', status: 'done' },
    ],
  });
  fs.writeFileSync(path.join(dir, 'data', 'events.jsonl'), '');
  writeJSON(path.join(root, 'settings.json'), {
    polling: { windows: [{ from: '00:00', every_minutes: 120 }], hold_overnight: false, wakes: [] },
    notifications: { on: false },
  });

  const bin = path.join(home, 'bin');
  fs.mkdirSync(bin);
  for (const name of ['claude', 'gh', 'codex', 'tailscale', 'launchctl', 'systemctl', 'loginctl', 'osascript']) {
    fs.writeFileSync(path.join(bin, name), '#!/bin/sh\nexit 1\n', { mode: 0o755 });
  }
  // The demo hub runs the stubs, so it never reaches the host's Tailscale (whose daemon kickflip would otherwise pick
  // over a stub first on PATH), and never restarts itself or its board for new code: the hub that serves this
  // worktree restarts the whole run when the worktree moves.
  hub = spawn(process.execPath, [path.join(worktree, 'hub', 'hub.mjs')], {
    cwd: worktree,
    env: {
      ...process.env, HOME: home, PATH: bin + path.delimiter + (process.env.PATH || ''),
      KICKFLIP_HUB_PORT: String(hubPort), KICKFLIP_CLAUDE: '/usr/bin/false',
      KICKFLIP_TAILSCALE: path.join(bin, 'tailscale'), KICKFLIP_CODE_RESTARTS: 'off',
    },
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  hub.stdout.pipe(process.stderr);
  hub.stderr.pipe(process.stderr);
  let announced = false;
  const lines = createInterface({ input: hub.stdout, crlfDelay: Infinity });
  lines.on('line', (line) => {
    if (!announced && !stopping && line.includes('hub on')) {
      announced = true;
      process.stdout.write(`port ${port}\n`);
    }
  });
  let failed = false;
  hub.once('error', (error) => { failed = true; console.error(error.message); });
  hub.once('close', (code) => process.exit(failed ? 1 : code ?? (stopping ? 0 : 1)));
}

main().catch((error) => { console.error(error.message); process.exit(1); });
